# ==========================================
# Configuración del Servidor y Seguridad
# ==========================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://kuropunk.vercel.app
FRONTEND_URL=https://kuropunk.vercel.app
FIREBASE_PROJECT_ID=kuroapp-62618
ADMIN_EMAILS=juanque.ovalle@gmail.com,admin@kuropunk.co
# Opcional: Clave de respaldo de servidor (mínimo 16 caracteres)
# ADMIN_SECRET_KEY=

# ==========================================
# Base de Datos: Opciones
# ==========================================
# En producción con PostgreSQL, puedes cambiar DB_SYNCHRONIZE=false tras crear las tablas
DB_SYNCHRONIZE=true
# Opción 1: SQLite (por defecto en local si no se define DB_TYPE)
DB_TYPE=sqlite
DATABASE_PATH=./tienda.sqlite

# Opción 2: PostgreSQL Local / Docker
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=crochet_admin
# DB_PASSWORD=crochet_secure_pass
# DB_DATABASE=tienda_crochet
# DB_SSL=false

# Opción 3: PostgreSQL en la nube (Supabase, Neon, Railway, Render)
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_SSL=true
