rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validates if authenticated user is administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@kuropunk.co' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Helper: Validates if authenticated user is the document owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. Colección de Productos (Catálogo)
    match /products/{productId} {
      // Lectura pública para cualquier visitante de la tienda
      allow read: if true;
      // Creación, edición y eliminación exclusiva para Administradores
      allow write: if isAdmin();
    }

    // 2. Colección de Pedidos (Sistema de Anticipo 20% >= $50.000 COP + Contraentrega)
    match /orders/{orderId} {
      // Creación de pedido:
      // - Si es >= $50.000 COP, debe iniciar obligatoriamente en 'ESPERANDO_PAGO'
      // - Si es < $50.000 COP, puede iniciar en 'EN_COLA' o 'placed'
      allow create: if request.resource.data.items.size() > 0 
                    && (request.resource.data.totalAmount > 0 || request.resource.data.total > 0)
                    && (
                      (
                        (request.resource.data.totalAmount >= 50000 || request.resource.data.total >= 50000)
                        && request.resource.data.status == 'ESPERANDO_PAGO'
                      ) || (
                        (request.resource.data.totalAmount < 50000 && request.resource.data.total < 50000)
                        && (request.resource.data.status == 'EN_COLA' || request.resource.data.status == 'placed')
                      )
                    );

      // Lectura: Dueño del pedido, consulta por ID de tracking o Administrador
      allow read: if true;

      // Actualización:
      // - Admin tiene control total (verificar anticipo -> EN_COLA, cambiar estado de taller, etc.)
      // - El comprador solo puede reportar su comprobante pasando de ESPERANDO_PAGO a VERIFICANDO_ANTICIPO
      allow update: if isAdmin() || (
        resource.data.status == 'ESPERANDO_PAGO'
        && request.resource.data.status == 'VERIFICANDO_ANTICIPO'
        && request.resource.data.paymentStatus == 'VERIFICANDO_ANTICIPO'
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 4
        && request.resource.data.totalAmount == resource.data.totalAmount
      );

      allow delete: if isAdmin();
    }

    // 3. Colección de Usuarios y Perfiles (Blindado contra Escalada de Privilegios / Role Tampering)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Al registrarse, un usuario normal SOLO puede crearse con rol 'customer'
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer')
      );
      // Al actualizar su perfil, un usuario NO puede alterar su propio campo 'role'
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    // 4. Colección de Reseñas / Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // 5. Colección de Mensajes de Contacto y Comisiones 1-de-1
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.name.size() > 0 
                    && request.resource.data.email.size() > 0 
                    && request.resource.data.message.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    // 6. Bloqueo por defecto para cualquier otra colección no declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
