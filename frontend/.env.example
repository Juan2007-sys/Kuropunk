# ==============================================================================
# KUROPUNK UNDERGROUND CROCHET - VARIABLES DE ENTORNO (FRONTEND VITE)
# ==============================================================================
# Instrucciones de configuración:
# 1. Copia este archivo como '.env' en esta misma carpeta (frontend/.env):
#    cp .env.example .env
# 2. Ve a Firebase Console: https://console.firebase.google.com/
# 3. Selecciona tu proyecto > Configuración del proyecto (icono de engranaje)
# 4. En la pestaña 'General', baja hasta 'Tus apps' y selecciona la app Web (</>)
# 5. Copia los valores del objeto firebaseConfig en las variables de abajo.
# 6. Reinicia el servidor de desarrollo Vite con 'npm run dev'.
# ==============================================================================

# Clave de API de Firebase (debe comenzar con AIzaSy...)
VITE_FIREBASE_API_KEY=AIzaSyTuClaveRealDeGoogleCloudFirebase12345

# Dominio de autenticación de Firebase
VITE_FIREBASE_AUTH_DOMAIN=kuropunk-crochet-shop.firebaseapp.com

# ID del proyecto en Google Cloud / Firebase
VITE_FIREBASE_PROJECT_ID=kuropunk-crochet-shop

# Bucket de almacenamiento para imágenes de productos (Firebase Storage)
VITE_FIREBASE_STORAGE_BUCKET=kuropunk-crochet-shop.appspot.com

# ID del remitente de mensajería (Cloud Messaging)
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475610

# ID de la aplicación Web de Firebase
VITE_FIREBASE_APP_ID=1:102938475610:web:8d910283746a5b12345678

# ID de medición de Google Analytics (Opcional)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# URL del Backend API (Servidor Express/Node)
VITE_API_URL=http://localhost:4000/api
